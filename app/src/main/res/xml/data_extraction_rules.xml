<?xml version="1.0" encoding="utf-8"?>
<!-- API-007: the offline image cache (filesDir/images/, up to ~300 MB) is re-downloaded from the
     bundle, so it is never backed up or transferred (Auto Backup stops above 25 MB). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="images/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="images/" />
    </device-transfer>
</data-extraction-rules>
