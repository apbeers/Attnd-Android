<?xml version="1.0" encoding="utf-8"?>
<!-- API-007: the offline image cache (filesDir/images/, up to ~300 MB) is re-downloaded from the
     bundle, so it is never backed up or transferred (Auto Backup stops above 25 MB).
     API-013: diagnostics (the log ring buffer in filesDir/logs/ and the debug session / upload cursors
     in attnd_diagnostics.xml) belong to this install only.
     The device id (attnd_device.xml) is never backed up or transferred, so two phones never share
     one; a reinstall on the same phone gets it back from Block Store (cloud backup off). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="sharedpref" path="attnd_diagnostics.xml" />
        <exclude domain="sharedpref" path="attnd_device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="sharedpref" path="attnd_diagnostics.xml" />
        <exclude domain="sharedpref" path="attnd_device.xml" />
    </device-transfer>
</data-extraction-rules>
