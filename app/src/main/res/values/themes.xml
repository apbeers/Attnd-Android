<resources>
    <!-- Window theme only; all UI is Compose (see ui/theme). Edge-to-edge: Android 15+ always; on 13 / 14 MainActivity
         stops fitting the system bars and these make them transparent (no deprecated window calls in code, so Play's
         edge-to-edge checks stay quiet). The splash screen is the platform's (Android 12+), from the same theme. -->
    <style name="Theme.Attnd" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/attnd_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_text</item>
    </style>
</resources>
