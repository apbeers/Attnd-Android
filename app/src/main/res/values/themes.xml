<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Attnd" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Attnd.NoActionBar" parent="Theme.Attnd" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/attnd_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/attnd_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Attnd</item>
    </style>
</resources>
